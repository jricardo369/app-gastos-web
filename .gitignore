# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore
# Optimizado para Ionic + Angular + Capacitor (movil)

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
bun.lockb
.yarn/*
!.yarn/releases/*.cjs
!.yarn/plugins/*.cjs

# --- Build output Angular / Ionic ---
/dist
/tmp
/out-tsc
/bazel-out
/.sourcemaps
/.versions
www/
!www/.gitkeep

# --- Angular cache & CLI ---
.angular/cache
.nx/cache
.nx/workspace-data
.sass-cache/
*.tmp
*.tmp.*
.tmp

# --- Capacitor ---
.ionic/
# Descomenta estas 2 lineas si generas android/ios con `npx cap add` en cada clon
# y NO personalizas codigo nativo. Si personalizas AndroidManifest, Info.plist, etc., NO las ignores.
# /android
# /ios
# Archivos locales de Capacitor CLI
capacitor.config.local.ts

# --- Cordova (legacy, por si migraste de Cordova) ---
/platforms
/plugins
/plugins/android.json
/plugins/ios.json

# --- Native secrets & signing (NUNCA subir) ---
*.keystore
*.jks
*.p12
*.pfx
*.key
*.mobileprovision
*.provisionprofile
google-services.json
GoogleService-Info.plist
local.properties
*.aab
*.apk
*.ipa

# --- Env variables ---
.env
.env.*
!.env.example
!.env.sample

# --- Tests & Coverage ---
/coverage
/coverage.*
libpeerconnection.log
testem.log
/typings

# --- Logs ---
*.log
log.txt
logs/

# --- IDEs and editors ---
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace
*.sw[mnpcod]
*~
# --- VS Code (no subir nada) ---
.vscode/
.history/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
$RECYCLE.BIN/

# --- Misc ---
connect.lock
